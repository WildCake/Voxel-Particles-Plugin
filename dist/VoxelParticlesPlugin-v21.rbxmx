local burstLoopActive = false
local burstButton = Instance.new("TextButton")
burstButton.Name = "BurstButton"
burstButton.Size = UDim2.new(0, 120, 1, 0)
burstButton.BackgroundColor3 = Color3.fromRGB(90, 140, 255)
